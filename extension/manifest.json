{
  "manifest_version": 3,
  "name": "QuantsPulse — Indian Equities Terminal",
  "version": "1.2.2",
  "description": "End-of-day rule-based signals, trade plans and key levels for NSE stocks, beside TradingView and Indian broker charts.",
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tradingview.com/*",
    "*://*.choiceindia.com/*",
    "*://*.zerodha.com/*",
    "*://*.groww.in/*",
    "*://*.dhan.co/*",
    "*://*.angelone.in/*",
    "*://*.upstox.com/*",
    "*://*.fyers.in/*",
    "*://*.kotaksecurities.com/*",
    "*://*.kotakneo.com/*",
    "*://*.icicidirect.com/*",
    "*://*.motilaloswal.com/*",
    "*://*.paytmmoney.com/*",
    "*://*.5paisa.com/*",
    "*://*.sharekhan.com/*",
    "*://*.hdfcsec.com/*",
    "*://*.hdfcsky.com/*",
    "*://*.axisdirect.in/*",
    "*://*.shoonya.com/*",
    "*://*.finvasia.com/*",
    "*://*.aliceblueonline.com/*",
    "*://*.google.com/finance/*",
    "*://finance.yahoo.com/*",
    "http://localhost:3000/*",
    "https://quantplus-ten.vercel.app/*"
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tradingview.com/*",
        "*://*.choiceindia.com/*",
        "*://*.zerodha.com/*",
        "*://*.groww.in/*",
        "*://*.dhan.co/*",
        "*://*.angelone.in/*",
        "*://*.upstox.com/*",
        "*://*.fyers.in/*",
        "*://*.kotaksecurities.com/*",
        "*://*.kotakneo.com/*",
        "*://*.icicidirect.com/*",
        "*://*.motilaloswal.com/*",
        "*://*.paytmmoney.com/*",
        "*://*.5paisa.com/*",
        "*://*.sharekhan.com/*",
        "*://*.hdfcsec.com/*",
        "*://*.hdfcsky.com/*",
        "*://*.axisdirect.in/*",
        "*://*.shoonya.com/*",
        "*://*.finvasia.com/*",
        "*://*.aliceblueonline.com/*",
        "*://*.google.com/finance/*",
        "*://finance.yahoo.com/*"
      ],
      "js": ["content-scripts/detector.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "https://quantplus-ten.vercel.app/*"
      ],
      "js": ["content-scripts/auth-sync.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open QuantsPulse Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
